  "quests": [
    {
      "id": "Q24",
      "name": "흰 부표를 따라",
      "location": "M07",
      "requires": [
        "Q20",
        "F07"
      ],
      "grants": [
        "Q24",
        "MAP09"
      ],
      "action": "R13 안전 항로를 따라 해무나루 구조대장 가온에게 도착 보고. 섬마을 안내도를 받고 옛 부두 조사 의뢰를 읽는다.",
      "optional": false,
      "repeatable": false
    },
    {
      "id": "Q25",
      "name": "물결 아래 남은 길",
      "location": "M07",
      "requires": [
        "Q24",
        "F02",
        "F06"
      ],
      "grants": [
        "Q25"
      ],
      "action": "입장 전 가온에게 동굴 안전도 수령. 너울잠굴에서 작은 낙석 정리·받침돌 2개 원위치·옛 부두 발판을 수동으로 내림. 미탐험 상세 지도는 표시하지 않음.",
      "optional": false,
      "repeatable": false,
      "acceptAt": "M07",
      "acceptRequires": [
        "Q24"
      ],
      "acceptGrants": [
        "MAP10"
      ],
      "requiredVisited": [
        "D09"
      ]
    },
    {
      "id": "Q26",
      "name": "쉬러 나온 동료들",
      "location": "M08",
      "requires": [
        "Q25"
      ],
      "grants": [
        "Q26",
        "MAP11",
        "protective_kit_3",
        "permit_D10"
      ],
      "action": "정화사 은서가 진득이 무리가 휴식대로 나온 것을 보여 줌. 주민 인터뷰 후 정화소 안내도·보호 장비·작업 허가를 입장 전에 지급.",
      "optional": false,
      "repeatable": false
    },
    {
      "id": "Q27",
      "name": "맑은 흐름의 순서",
      "location": "D10",
      "requires": [
        "Q26",
        "F02",
        "F04",
        "protective_kit_3",
        "permit_D10"
      ],
      "grants": [
        "Q27",
        "coast_ferry_3"
      ],
      "action": "기존 취수 기록 대조→우회수로 개방→교체 거름틀을 받침에 이동→휴식대 물길 복구. 감독과 1회 대결 후 누락된 정비표를 고정 확보. 정기선·5관장 개방.",
      "optional": false,
      "repeatable": false
    },
    {
      "id": "Q28",
      "name": "푸른숨의 시험",
      "location": "M08",
      "requires": [
        "Q27"
      ],
      "grants": [
        "Q28",
        "badge_5"
      ],
      "action": "관장 하진에게 상태이상 대응·교체 시험. 의무 부가 포획이나 독 동료 소유 조건 없음.",
      "optional": false,
      "repeatable": false
    },
    {
      "id": "Q29",
      "name": "거센 물에도 돌아오는 길",
      "location": "M07",
      "requires": [
        "Q28"
      ],
      "grants": [
        "Q29",
        "F08",
        "current_bridle"
      ],
      "action": "정기선으로 해무나루 재방문. 교관 여민이 지원 해품범·급류용 물판 고정끈 지급. 표시된 2개 물살에서 진입/횡단/안전 하선/귀환 연습.",
      "optional": false,
      "repeatable": false
    },
    {
      "id": "Q30_start",
      "name": "강 위의 운송표",
      "location": "M08",
      "requires": [
        "Q29"
      ],
      "grants": [
        "Q30_start",
        "MAP12"
      ],
      "action": "푸른숨 부두의 운송원 담소가 강·운송도시 개략도를 지급. 강굽이 쉼터에 운송표 전달을 부탁. 가려진 지형·배차소 내부는 유지.",
      "optional": false,
      "repeatable": false
    },
    {
      "id": "Q30",
      "name": "움직이지 않는 작은 수문",
      "location": "H02",
      "requires": [
        "Q30_start",
        "F08",
        "F02",
        "F06"
      ],
      "grants": [
        "Q30",
        "freight_bridge_3"
      ],
      "action": "강굽이 쉼터의 무료 점검 보행로로 이동. 수문 옆 레일의 작은 받침 복구→수동 윈치 재연결→낮은 운송 다리 개방. F09는 요구하지 않음.",
      "optional": false,
      "repeatable": false
    },
    {
      "id": "Q31_start",
      "name": "같은 부품, 다른 기록",
